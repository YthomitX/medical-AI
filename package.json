{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
    "scripts": {
    "dev": "vite",
    "build": "vite build",

    "dev:local": "copyfiles -f .env.local ./ && rename .env.local .env && vite",
    "dev:prod": "copyfiles -f .env.production ./ && rename .env.production .env && vite",

    "build:local": "copyfiles -f .env.local ./ && rename .env.local .env && vite build",
    "build:prod": "copyfiles -f .env.production ./ && rename .env.production .env && vite build"
    },
  "devDependencies": {
