    "cross-env": "^10.1.0",
    "laravel-vite-plugin": "^3.2.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.1.0",
    "vite": "^8.3.0"
  },
  "name": "medical-ai",
  "version": "1.0.0",
  "description": "Medical AI frontend with Laravel + Vite",
  "main": "postcss.config.js",
